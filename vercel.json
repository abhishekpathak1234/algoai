{
  "redirects": [
    { "source": "/auto", "destination": "/auto/", "permanent": false },
    { "source": "/easy-ai", "destination": "/easyai", "permanent": false },
    { "source": "/easy-ai/:path*", "destination": "/easyai/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/partner/assets/:path*", "destination": "https://algobridge-claude-code-2026-07-15.vercel.app/assets/:path*" },
    { "source": "/partner/logo.png", "destination": "https://algobridge-claude-code-2026-07-15.vercel.app/logo.png" },
    { "source": "/partner", "destination": "https://algobridge-claude-code-2026-07-15.vercel.app/partner/" },
    { "source": "/partner/", "destination": "https://algobridge-claude-code-2026-07-15.vercel.app/partner/" },
    { "source": "/partner/:path*", "destination": "https://algobridge-claude-code-2026-07-15.vercel.app/partner/:path*" },
    { "source": "/private1", "destination": "https://private-docs-deploy.vercel.app" },
    { "source": "/private1/", "destination": "https://private-docs-deploy.vercel.app" },
    { "source": "/auto/assets/:path*", "destination": "https://algo-auto.vercel.app/assets/:path*" },
    { "source": "/auto/manifest.json", "destination": "https://algo-auto.vercel.app/manifest.json" },
    { "source": "/auto/robots.txt", "destination": "https://algo-auto.vercel.app/robots.txt" },
    { "source": "/auto/sitemap.xml", "destination": "https://algo-auto.vercel.app/sitemap.xml" },
    { "source": "/auto", "destination": "https://algo-auto.vercel.app/" },
    { "source": "/auto/", "destination": "https://algo-auto.vercel.app/" },
    { "source": "/easyai", "destination": "https://algo-easy-ai.vercel.app/easyai" },
    { "source": "/easyai/:path*", "destination": "https://algo-easy-ai.vercel.app/easyai/:path*" },
    { "source": "/realty/assets/:path*", "destination": "https://algo-realty.vercel.app/assets/:path*" },
    { "source": "/realty/images/:path*", "destination": "https://algo-realty.vercel.app/images/:path*" },
    { "source": "/realty/favicon.ico", "destination": "https://algo-realty.vercel.app/favicon.ico" },
    { "source": "/realty/robots.txt", "destination": "https://algo-realty.vercel.app/robots.txt" },
    { "source": "/realty", "destination": "https://algo-realty.vercel.app/realty/" },
    { "source": "/realty/", "destination": "https://algo-realty.vercel.app/realty/" },
    { "source": "/realty/:path*", "destination": "https://algo-realty.vercel.app/realty/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://assets.calendly.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://assets.calendly.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.googleusercontent.com https://assets.calendly.com; frame-src https://calendly.com https://*.calendly.com; connect-src 'self' https://api.web3forms.com https://*.calendly.com https://bfhvwccffsrlshqejvhv.supabase.co; form-action https://api.web3forms.com; base-uri 'self'; frame-ancestors 'none'; object-src 'none'"
        }
      ]
    }
  ]
}
